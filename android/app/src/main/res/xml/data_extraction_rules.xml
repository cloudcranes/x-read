<?xml version="1.0" encoding="utf-8"?>
<!--
  内容核心与用户数据一律留在设备上：不上传、不迁移、不参与 adb backup。
  应用整体已 allowBackup=false，这里额外显式声明，防止将来有人改回 true 时
  把密钥目录悄悄带上云。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
