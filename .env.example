# Copy to .env for Docker Compose; local python does not auto-load this file.
X_READ_HOST=127.0.0.1
X_READ_PORT=8080
# Docker published host IP. Set your LAN IP for LAN-only access.
X_READ_BIND_ADDRESS=127.0.0.1
X_READ_DB=data/x-read.sqlite3
# Required for non-loopback unless anonymous mode explicitly enabled.
# Generate a token: openssl rand -hex 32
X_READ_ALLOW_ANONYMOUS=false
X_READ_API_TOKEN=
X_READ_METADATA_TTL=600
X_READ_CHAPTER_TTL=604800
X_READ_CACHE_BUDGET_BYTES=268435456
# Explicit comma-separated frontend origins; empty disables cross-origin access.
X_READ_CORS_ORIGINS=
# Optional: path to a built Android APK to expose at /x-read.apk.
# Empty means the route returns 404 (the app is a standalone APK, not served here).
X_READ_APK_PATH=
